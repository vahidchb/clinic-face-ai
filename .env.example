# Copy to .env and put your own Hormouz API key in AI_GATEWAY_API_KEY.
# Never commit .env — it holds a secret. Never put the key in chat or code.
AI_GATEWAY_BASE_URL=https://api.hormouz.net/v1
AI_GATEWAY_API_KEY=
AI_VISION_MODEL=google/gemini-3.1-flash-lite
AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
